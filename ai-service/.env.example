# Application
APP_NAME=NextFarm AI Service
APP_VERSION=1.0.0
API_PREFIX=/api/v1

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Whisper
WHISPER_MODEL=base
WHISPER_LANGUAGE=vi
WHISPER_INITIAL_PROMPT=Nhật ký canh tác NextFarm bằng tiếng Việt. Các từ thường gặp: lô A1, lô A2, lô B1, thửa đất, bón phân, phân NPK, phân urê, phun thuốc, tưới nước, làm cỏ, thu hoạch, sâu cuốn lá, vàng lá, sâu bệnh, mức độ nhẹ, mức độ trung bình, mức độ nặng, vụ hè thu, vụ đông xuân, giao cho, hạn ngày, ngày 20 tháng 9, ngày 15 tháng 6, ngày 30 tháng 9, tạo vụ, trồng lúa, trồng cây, xuống giống, ngày xuống giống, ngày gieo trồng, loại cây trồng, tên cây trồng, nhóm cây trồng, nhóm cây lương thực, mã cây trồng, mã gợi ý, thời gian thu hoạch, kilogram, kg, gam, lít, chai, bao.

# Uploads
UPLOAD_DIR=uploads

# Safeguards
REQUEST_TIMEOUT_SECONDS=60